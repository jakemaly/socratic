        <mxCell id="legendModel" value="Model / adapter" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=11;fontColor=#263238;align=left;verticalAlign=middle;" vertex="1" parent="legend">
