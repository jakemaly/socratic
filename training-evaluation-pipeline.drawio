        <mxCell id="source" value="Sources: train/config-next-sft.yaml · train/README.md · eval/README.md · docs/research/fine-tuning-evolution.md · results/summary.md" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#78909c;" vertex="1" parent="1">
