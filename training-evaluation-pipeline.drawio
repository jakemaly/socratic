        <mxCell id="legendData" value="Data / cases" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;fontColor=#263238;align=left;verticalAlign=middle;" vertex="1" parent="legend">
          <mxGeometry x="15" y="28" width="115" height="25" as="geometry" />
