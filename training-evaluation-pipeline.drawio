        <mxCell id="legendProcess" value="Process / metric" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;fontColor=#263238;align=left;verticalAlign=middle;" vertex="1" parent="legend">
          <mxGeometry x="145" y="28" width="125" height="25" as="geometry" />
