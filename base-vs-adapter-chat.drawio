        <mxCell id="baseUser" value="&lt;b&gt;You&lt;/b&gt;&lt;br&gt;“Just give me the complete condition for the leap-year checker.”" style="shape=callout;perimeter=calloutPerimeter;size=15;position=0.5;flipH=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#263238;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="basePanel">
