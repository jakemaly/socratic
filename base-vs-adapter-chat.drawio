        <mxCell id="subtitle" value="The adapter keeps the same base model, but shifts how it handles a request for a finished answer." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#607d8b;" vertex="1" parent="1">
