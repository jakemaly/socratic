        <mxCell id="takeaway" value="&lt;b&gt;The point of the adapter&lt;/b&gt;&lt;br&gt;It does not replace the base model. It nudges the same model toward a useful boundary: refuse the finished artifact, diagnose the misconception, and ask what to try next." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#263238;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=20;" vertex="1" parent="1">
          <mxGeometry x="50" y="780" width="1300" height="100" as="geometry" />
        </mxCell>
