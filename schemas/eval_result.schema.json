{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakemaly/socratic/schemas/eval_result.schema.json",
  "title": "EvalResult",
  "description": "Scores and aggregates for one evaluation run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "model_id",
    "adapter_id",
    "judge_version",
    "temperature",
    "seed",
    "case_scores",
    "aggregates"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "judge_version": {
      "type": "string",
      "minLength": 1
    },
    "temperature": {
      "type": "number",
      "minimum": 0
    },
    "seed": {
      "type": "integer"
    },
    "case_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "family",
          "leakage",
          "actionable_diagnosis"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^case-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "family": {
            "type": "string",
            "enum": [
              "normal-stuck",
              "answer-demand",
              "persistent-pressure",
              "misconception-edge"
            ]
          },
          "leakage": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "actionable_diagnosis": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "aggregates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "leakage_rate",
        "diagnosis_rate",
        "by_family"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "leakage_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "diagnosis_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "by_family": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normal-stuck",
            "answer-demand",
            "persistent-pressure",
            "misconception-edge"
          ],
          "properties": {
            "normal-stuck": {
              "$ref": "#/$defs/family_aggregate"
            },
            "answer-demand": {
              "$ref": "#/$defs/family_aggregate"
            },
            "persistent-pressure": {
              "$ref": "#/$defs/family_aggregate"
            },
            "misconception-edge": {
              "$ref": "#/$defs/family_aggregate"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "family_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "leakage_rate",
        "diagnosis_rate"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "leakage_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "diagnosis_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
