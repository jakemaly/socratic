{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakemaly/socratic/schemas/demo_evidence.schema.json",
  "title": "DemoEvidence",
  "description": "Complete fixed-benchmark presentation record rendered by the Socratic Tutor demo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "available",
    "benchmark",
    "selected_model",
    "base",
    "fine_tuned",
    "leakage_reduction_points",
    "diagnosis_change_points",
    "calibration",
    "limitations",
    "transcripts",
    "source_artifacts"
  ],
  "properties": {
    "available": {
      "type": "boolean",
      "const": true
    },
    "benchmark": {
      "$ref": "#/$defs/benchmark"
    },
    "selected_model": {
      "$ref": "#/$defs/selected_model"
    },
    "base": {
      "$ref": "#/$defs/model_aggregate"
    },
    "fine_tuned": {
      "$ref": "#/$defs/model_aggregate"
    },
    "leakage_reduction_points": {
      "type": "number"
    },
    "diagnosis_change_points": {
      "type": "number"
    },
    "calibration": {
      "$ref": "#/$defs/calibration"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "transcripts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/transcript"
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/source_artifact"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "path": {
                "enum": [
                  "results/benchmark.json",
                  "/results/benchmark.json"
                ]
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "path": {
                "enum": [
                  "results/summary.md",
                  "/results/summary.md"
                ]
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "path": {
                "enum": [
                  "results/evidence-transcripts.md",
                  "/results/evidence-transcripts.md"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "rate": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "string",
          "pattern": "^(?:100(?:\\.0+)?|[0-9]{1,2}(?:\\.[0-9]+)?)%$"
        }
      ]
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "case_count",
        "judge_version",
        "temperature",
        "seed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "fixed 48-case benchmark"
        },
        "case_count": {
          "type": "integer",
          "const": 48
        },
        "judge_version": {
          "type": "string",
          "minLength": 1
        },
        "judge_model": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number",
          "const": 0
        },
        "seed": {
          "type": "integer",
          "const": 0
        },
        "case_source": {
          "type": "string",
          "minLength": 1
        },
        "case_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "system_prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decoding": {
          "type": "string",
          "minLength": 1
        },
        "max_new_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "selected_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "checkpoint",
        "epoch",
        "run_id"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "epoch-2"
        },
        "epoch": {
          "type": "integer",
          "const": 2
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "adapter_id",
        "case_count",
        "leakage_count",
        "diagnosis_count",
        "leakage_rate",
        "diagnosis_rate",
        "by_family"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "case_count": {
          "type": "integer",
          "const": 48
        },
        "leakage_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "diagnosis_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "leakage_rate": {
          "$ref": "#/$defs/rate"
        },
        "diagnosis_rate": {
          "$ref": "#/$defs/rate"
        },
        "by_family": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normal-stuck",
            "answer-demand",
            "persistent-pressure",
            "misconception-edge"
          ],
          "properties": {
            "normal-stuck": {
              "$ref": "#/$defs/family_aggregate"
            },
            "answer-demand": {
              "$ref": "#/$defs/family_aggregate"
            },
            "persistent-pressure": {
              "$ref": "#/$defs/family_aggregate"
            },
            "misconception-edge": {
              "$ref": "#/$defs/family_aggregate"
            }
          }
        }
      }
    },
    "family_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "leakage_count",
        "diagnosis_count",
        "leakage_rate",
        "diagnosis_rate"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "leakage_count": {
          "type": "integer",
          "minimum": 0
        },
        "diagnosis_count": {
          "type": "integer",
          "minimum": 0
        },
        "leakage_rate": {
          "$ref": "#/$defs/rate"
        },
        "diagnosis_rate": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "agreement",
        "source"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_performed",
            "unavailable",
            "completed"
          ]
        },
        "agreement": {
          "anyOf": [
            {
              "$ref": "#/$defs/rate"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "annotation",
        "messages"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "actionable-diagnosis",
            "firm-answer-redirect"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "annotation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "messages": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "path"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "path": {
          "type": "string",
          "enum": [
            "results/benchmark.json",
            "results/summary.md",
            "results/evidence-transcripts.md",
            "/results/benchmark.json",
            "/results/summary.md",
            "/results/evidence-transcripts.md"
          ]
        }
      }
    }
  }
}
